{
  "name": "chamados-backend",
  "version": "1.0.0",
  "description": "Backend do sistema de abertura de chamados via WhatsApp com integração GLPI",
  "main": "dist/app.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/app.ts",
    "build": "tsc",
    "start": "node dist/app.js",
    "migrate": "ts-node src/models/migrate.ts",
    "lint": "eslint src/**/*.ts"
  },
  "dependencies": {
    "axios": "^1.7.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "mysql2": "^3.10.1",
    "pg": "^8.12.0",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.3",
    "uuid": "^10.0.0",
    "winston": "^3.13.0",
    "adminjs": "6.8.7",
    "@adminjs/express": "5.1.0",
    "@adminjs/sequelize": "3.0.0",
    "express-formidable": "^1.2.0",
    "express-session": "^1.18.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.14.10",
    "@types/uuid": "^10.0.0",
    "@types/express-session": "^1.18.0",
    "typescript": "^5.5.3",
    "ts-node-dev": "^2.0.0"
  }
}
